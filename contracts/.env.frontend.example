# 프론트엔드(종현 선배)용 공개 설정. 실제 .env는 절대 커밋하지 않는다.

# 개발 환경에서는 Mock API 주소를 사용한다.
# 백엔드와 같은 도메인에 배포할 때는 비워 두고 상대경로 /api를 사용할 수 있다.
VITE_API_BASE_URL=http://localhost:4000

# Supabase 클라이언트(로그인용). 실제 값은 .env.local에만 둔다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── 아래는 서버 전용. 프론트 .env에 절대 넣지 않는다 ──
# GEMINI_API_KEY          (서버만)
# SUPABASE_SERVICE_ROLE_KEY (서버만, 정말 필요할 때만)
