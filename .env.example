# Context Bridge 통합 실행용 예시
# 실제 값은 프로젝트 루트의 .env.local에 저장하고 Git에 커밋하지 않습니다.

# ── 브라우저 공개 설정 ──
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# 구형 프로젝트 키 이름도 지원하지만 둘 중 하나만 사용하세요.
# VITE_SUPABASE_ANON_KEY=

# 통합 npm run dev / Vercel 동일 도메인은 비워 둡니다.
VITE_API_BASE_URL=

# ── Node/Express 서버 설정 ──
# 브라우저와 반드시 같은 Supabase 프로젝트 URL을 사용하세요.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 구형 프로젝트 키 이름도 지원하지만 둘 중 하나만 사용하세요.
# SUPABASE_ANON_KEY=

# 선택 사항: 없으면 결정적 오프라인 답변으로 동작합니다.
GEMINI_API_KEY=
PORT=3000

# 운영 배포에서 허용할 프론트 Origin. 여러 개면 쉼표로 구분합니다.
# 예: https://context-bridge.vercel.app,https://www.example.com
CORS_ALLOWED_ORIGINS=
